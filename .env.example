# ---------------------------------------------------------------------------
# ABUTRON QUANT — credentials (copy to .env and `set -a; . ./.env; set +a`)
# Never commit the real file. The engine only reads these from the environment.
# ---------------------------------------------------------------------------

# Deriv (demo first). Create a token in your Deriv account: Settings -> API token.
# Scopes needed: read + trade. Use a DEMO account token until validation is done.
DERIV_TOKEN=
DERIV_APP_ID=1089

# FP Markets MetaTrader 5 (Windows host running the terminal)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FP-Markets-Demo
# Optional explicit terminal path:
MT5_PATH=

# Optional local LLM reviewer (Ollama). Leave disabled in production.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
